{
  "name": "caldron-sheets",
  "version": "0.0.0",
  "description": "Ficha + inventário + journal de RPG (Caldronis), PWA offline-first",
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "icons": "node scripts/gen-icons.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run e2e",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-caldron"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "dexie": "^4.4.7",
    "preact": "^11.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/preact": "^3.2.6",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.7",
    "firebase-tools": "^15.35.0",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
