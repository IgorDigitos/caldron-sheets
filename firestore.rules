rules_version = '2';

// Papéis (etapa 5):
// - Mestre: lê e escreve tudo.
// - Jogador: só as fichas em que é o dono (`donoUid`). Pode mexer em recursos, extra, histórico,
//   carteira, inventário, journal e no extra/perda dos atributos. NÃO pode mudar base dos atributos,
//   nome, raça, classe, nível, dono, nem criar/apagar fichas.
//
// Os máximos (Vida, STA, Mana, Corpo…) são calculados no aparelho de quem edita. Quando é o
// jogador, o servidor REFAZ a conta das fórmulas do Caldronis abaixo e recusa máximo inventado.
// ⚠️ Se as fórmulas de src/rules/caldronis.ts mudarem, `maximosConferem` tem que mudar junto.
//
// "Última edição ganha": toda atualização precisa trazer `atualizadoEm` >= o do servidor.

service cloud.firestore {
  match /databases/{database}/documents {

    function logado() {
      return request.auth != null;
    }

    function caminhoCampanha() {
      return /databases/$(database)/documents/campanha/config;
    }

    function ehMestre() {
      return logado()
        && exists(caminhoCampanha())
        && get(caminhoCampanha()).data.mestreUid == request.auth.uid;
    }

    function idConfere(id) {
      return request.resource.data.id == id;
    }

    function naoMaisVelha() {
      return request.resource.data.atualizadoEm is number
        && request.resource.data.atualizadoEm >= resource.data.atualizadoEm;
    }

    function temFicha() {
      return request.resource.data.fichaId is string;
    }

    /** O usuário logado é o dono da ficha `fichaId`. */
    function donoDaFicha(fichaId) {
      return logado()
        && get(/databases/$(database)/documents/personagens/$(fichaId)).data.get('donoUid', '') == request.auth.uid;
    }

    // ---------- Conta das fórmulas (espelho de src/rules/caldronis.ts) ----------

    function valorAtual(attrs, a) {
      return attrs[a].base + attrs[a].get('extra', 0) - attrs[a].get('perda', 0);
    }

    function perto(a, b) {
      return math.abs(a - b) < 0.000001;
    }

    // Vida/STA/Mana são inteiros arredondados para o mais próximo. Tolerância de meio ponto para
    // não brigar com o arredondamento de ponto flutuante do JavaScript.
    function inteiroPerto(v, x) {
      return v == math.floor(v) && math.abs(v - x) <= 0.5000001;
    }

    function maximosConferem(d, antes) {
      let at = d.atributos;
      let ajustes = d.get('ajustes', {});
      let con = valorAtual(at, 'CON');
      let corpo = (valorAtual(at, 'FOR') + valorAtual(at, 'DES') + con) / 3.0 + ajustes.get('CORPO', 0);
      let mente = (valorAtual(at, 'INT') + valorAtual(at, 'SAB') + valorAtual(at, 'CAR')) / 3.0 + ajustes.get('MENTE', 0);
      let m = d.maximos;
      return perto(m.CORPO, corpo)
        && perto(m.MENTE, mente)
        && inteiroPerto(m.VIDA, d.nivel * 5 + corpo * 2 + con * 5)
        && inteiroPerto(m.STA, 5 + corpo * 2 + con)
        && inteiroPerto(m.MANA, 5 + mente * 3)
        && perto(m.DESLOCAMENTO, 7.5 + math.floor(corpo / 3.0) * 1.5)
        && perto(m.DEF_NATURAL, corpo + con / 2.0)
        && perto(m.DEF_MAGICA_NATURAL, mente + valorAtual(at, 'SAB') / 2.0)
        // Só dependem do nível, que o jogador não muda.
        && m.PA == antes.maximos.PA
        && m.CONTRABALANCO == antes.maximos.CONTRABALANCO;
    }

    function atuaisValidos(d) {
      return d.atuais.VIDA <= d.maximos.VIDA
        && d.atuais.STA >= 0 && d.atuais.STA <= d.maximos.STA
        && d.atuais.MANA >= 0 && d.atuais.MANA <= d.maximos.MANA;
    }

    // Recursos personalizados (ex.: Ímpeto). Regras não têm laço, então a conferência é "desenrolada"
    // para até 6 recursos (MAX_PERSONALIZADOS em src/dominio/recursos.ts).
    function personalizadoOk(atuais, maximos, ids, i) {
      return ids.size() <= i
        || (atuais[ids[i]] is number && atuais[ids[i]] >= 0 && atuais[ids[i]] <= maximos[ids[i]]);
    }

    function personalizadosValidos(d) {
      let atuais = d.get('personalizados', {});
      let maximos = d.get('maxPersonalizados', {});
      let ids = atuais.keys();
      return ids.size() <= 6
        && ids.toSet() == maximos.keys().toSet()
        && personalizadoOk(atuais, maximos, ids, 0) && personalizadoOk(atuais, maximos, ids, 1)
        && personalizadoOk(atuais, maximos, ids, 2) && personalizadoOk(atuais, maximos, ids, 3)
        && personalizadoOk(atuais, maximos, ids, 4) && personalizadoOk(atuais, maximos, ids, 5);
    }

    function baseIgual(a) {
      return request.resource.data.atributos[a].base == resource.data.atributos[a].base;
    }

    /** O que o jogador pode mudar na própria ficha. */
    function edicaoDeJogador() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['atuais', 'extras', 'personalizados', 'historico', 'alteracoes', 'carteira', 'atributos', 'maximos', 'atualizadoEm'])
        && d.atributos.keys().hasOnly(['FOR', 'DES', 'CON', 'INT', 'SAB', 'CAR'])
        && baseIgual('FOR') && baseIgual('DES') && baseIgual('CON')
        && baseIgual('INT') && baseIgual('SAB') && baseIgual('CAR')
        && maximosConferem(d, resource.data)
        && atuaisValidos(d)
        && personalizadosValidos(d);
    }

    // ---------- Coleções ----------

    // Quem é o Mestre. Leitura pública (só revela um uid) porque a tela de login precisa saber se a
    // campanha já tem Mestre. Criado uma única vez, no primeiro acesso, pelo próprio Mestre.
    match /campanha/config {
      allow read: if true;
      allow create: if logado()
        && request.resource.data.mestreUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['mestreUid', 'criadoEm']);
      allow update, delete: if false;
    }

    // Contas de jogador. Só o Mestre cria; cada um lê a própria.
    match /usuarios/{uid} {
      allow read: if ehMestre() || (logado() && request.auth.uid == uid);
      allow create, update: if ehMestre()
        && request.resource.data.papel == 'jogador'
        && request.resource.data.usuario is string
        && request.resource.data.keys().hasOnly(['usuario', 'papel', 'criadoEm']);
      allow delete: if ehMestre();
    }

    match /personagens/{id} {
      allow read: if ehMestre() || (logado() && resource.data.get('donoUid', '') == request.auth.uid);
      allow create: if ehMestre() && idConfere(id) && request.resource.data.atualizadoEm is number;
      allow delete: if ehMestre();
      allow update: if idConfere(id) && naoMaisVelha() && (
        ehMestre()
        || (logado() && resource.data.get('donoUid', '') == request.auth.uid && edicaoDeJogador())
      );
    }

    // Itens, journal e imagens pertencem a uma ficha (`fichaId`); o dono da ficha mexe à vontade.
    match /itens/{id} {
      allow read, delete: if ehMestre() || donoDaFicha(resource.data.fichaId);
      allow create: if idConfere(id) && temFicha() && request.resource.data.atualizadoEm is number
        && (ehMestre() || donoDaFicha(request.resource.data.fichaId));
      allow update: if idConfere(id) && temFicha() && naoMaisVelha()
        && (ehMestre() || (donoDaFicha(resource.data.fichaId) && request.resource.data.fichaId == resource.data.fichaId));
    }

    match /journal/{id} {
      allow read, delete: if ehMestre() || donoDaFicha(resource.data.fichaId);
      allow create: if idConfere(id) && temFicha() && request.resource.data.atualizadoEm is number
        && (ehMestre() || donoDaFicha(request.resource.data.fichaId));
      allow update: if idConfere(id) && temFicha() && naoMaisVelha()
        && (ehMestre() || (donoDaFicha(resource.data.fichaId) && request.resource.data.fichaId == resource.data.fichaId));
    }

    // Catálogo de recursos personalizados da campanha. Todo mundo logado lê (o jogador precisa do
    // nome e da cor para desenhar a barra); só o Mestre cria, edita e apaga.
    match /recursos/{id} {
      allow read: if logado();
      allow create, update: if ehMestre() && idConfere(id)
        && request.resource.data.nome is string
        && request.resource.data.formula is string
        && request.resource.data.atualizadoEm is number;
      allow delete: if ehMestre();
    }

    // Skills (Magias, Técnicas, Habilidades): só o Mestre cria e edita; o dono da ficha só lê.
    // Usar uma skill gasta recurso na FICHA (regra de personagens), não muda o documento da skill.
    match /skills/{id} {
      allow read: if ehMestre() || donoDaFicha(resource.data.fichaId);
      allow create: if ehMestre() && idConfere(id) && temFicha() && request.resource.data.atualizadoEm is number;
      allow update: if ehMestre() && idConfere(id) && temFicha() && naoMaisVelha();
      allow delete: if ehMestre();
    }

    // Imagens não são editadas: só criadas e apagadas. Limite de tamanho abaixo do 1MB do Firestore.
    match /imagens/{id} {
      allow read, delete: if ehMestre() || donoDaFicha(resource.data.fichaId);
      allow create, update: if idConfere(id) && temFicha()
        && (ehMestre() || donoDaFicha(request.resource.data.fichaId))
        && request.resource.data.dataUrl is string
        && request.resource.data.dataUrl.size() < 700000
        && request.resource.data.dataUrl.split(',')[0]
          in ['data:image/webp;base64', 'data:image/jpeg;base64', 'data:image/png;base64'];
    }

    // ---------- Mesa (chat + rolagens) ----------
    // O app só PEDE a rolagem (estado 'pendente'). Quem rola é o bot Caldronis Dice, com a conta de
    // serviço (Admin SDK, fora destas regras): ele preenche resultado, erro e envio ao Discord.
    // Por isso ninguém atualiza mensagem pelo app.

    function jogadorDaCampanha() {
      return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function mensagemValida(id) {
      let d = request.resource.data;
      return idConfere(id)
        && d.keys().hasOnly(['id', 'autorUid', 'fichaId', 'nome', 'texto', 'tipo', 'criadoEm', 'estado', 'recebidoEm', 'descanso'])
        // Descanso curto: rolagem de um personagem que recupera Vida, Stamina ou Mana.
        && (!('descanso' in d) || (d.tipo == 'rolagem' && 'fichaId' in d && d.descanso in ['VIDA', 'STA', 'MANA']))
        && d.autorUid == request.auth.uid
        && d.texto is string && d.texto.size() > 0 && d.texto.size() <= 1000
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 60
        && d.criadoEm is number
        // Hora do servidor: o bot não rola pedido que ficou parado na fila sem internet.
        && d.recebidoEm == request.time
        && ((d.tipo == 'texto' && !('estado' in d)) || (d.tipo == 'rolagem' && d.estado == 'pendente'));
    }

    /** Jogador fala/rola como um personagem DELE, com o nome que está na ficha. */
    function falaComoPersonagem() {
      let d = request.resource.data;
      let ficha = get(/databases/$(database)/documents/personagens/$(d.fichaId)).data;
      return 'fichaId' in d && d.fichaId is string
        && ficha.get('donoUid', '') == request.auth.uid
        && ficha.nome == d.nome;
    }

    match /mesa/{id} {
      allow read: if ehMestre() || jogadorDaCampanha();
      allow create: if logado() && mensagemValida(id) && (ehMestre() || (jogadorDaCampanha() && falaComoPersonagem()));
      allow update: if false;
      allow delete: if ehMestre();
    }

    // Canal do Mestre: rolagens secretas, vão para o canal do Discord que só o Mestre vê.
    match /mesaMestre/{id} {
      allow read, delete: if ehMestre();
      allow create: if ehMestre() && mensagemValida(id);
      allow update: if false;
    }

    // Todo o resto: fechado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
